{
  "name": "qqbot",
  "version": "1.0.0",
  "description": "QQ Bot with multi-protocol support (Milky, OneBot11, Satori)",
  "type": "module",
  "packageManager": "bun@1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run scripts/supervisor/cli.ts start",
    "stop": "bun run scripts/supervisor/cli.ts stop",
    "restart": "bun run scripts/supervisor/cli.ts restart",
    "status": "bun run scripts/supervisor/cli.ts status",
    "logs": "bun run scripts/supervisor/cli.ts logs",
    "bot": "bun run packages/bot/src/index.ts",
    "deploy": "bun run scripts/deploy.ts",
    "web": "bun run --filter @qqbot/webui dev",
    "ui:start": "bun run scripts/ui.ts start",
    "ui:stop": "bun run scripts/ui.ts stop",
    "ui:restart": "bun run scripts/ui.ts restart",
    "ui:status": "bun run scripts/ui.ts status",
    "dev": "concurrently -n bot,ui -c blue,green \"bun run packages/bot/src/index.ts\" \"bun run --filter @qqbot/webui dev\"",
    "build": "bun run --filter @qqbot/bot build",
    "build:dev": "bun run --filter @qqbot/bot build:dev",
    "build:all": "bun run --filter @qqbot/bot build:all",
    "build:watch": "bun run --filter @qqbot/bot build:watch",
    "build:admin": "bun run --filter @qqbot/webui build",
    "debug": "bun run --filter @qqbot/bot debug",
    "typecheck": "tsc -b",
    "type-check": "tsc -b",
    "lint": "biome check packages/*/src scripts/supervisor scripts/deploy.ts scripts/ui.ts && bun run lint:di",
    "lint:di": "bun run scripts/lint/container-lookups.ts",
    "lint:fix": "biome check --write packages/*/src scripts/supervisor scripts/deploy.ts scripts/ui.ts",
    "format": "biome format --write packages/*/src scripts/supervisor scripts/deploy.ts scripts/ui.ts",
    "nai-usage": "NO_FILE_LOG=1 bun run packages/bot/src/cli/nai-usage.ts",
    "smoke-test": "NO_FILE_LOG=1 bun run packages/bot/src/cli/smoke-test.ts",
    "rag:reembed": "NO_FILE_LOG=1 bun run packages/bot/src/cli/rag-reembed.ts",
    "memory": "NO_FILE_LOG=1 bun run packages/bot/src/cli/memory.ts",
    "cluster:e2e": "bun run --filter @qqbot/bot cluster:e2e",
    "cluster:e2e:claude": "bun run --filter @qqbot/bot cluster:e2e:claude",
    "cluster:e2e:gemini": "bun run --filter @qqbot/bot cluster:e2e:gemini",
    "cluster:e2e:codex": "bun run --filter @qqbot/bot cluster:e2e:codex",
    "cluster-tickets:sync": "bun run --filter @qqbot/bot cluster-tickets:sync",
    "test": "bun test packages/bot scripts",
    "test:network": "NETWORK_TESTS=1 bun test packages/bot scripts",
    "prepare": "husky"
  },
  "keywords": [
    "qqbot",
    "qq",
    "bot",
    "milky",
    "onebot",
    "satori"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  }
}
