// Configuration of the cluster daemon (`bun run packages/agent-cluster/src/daemon/main.ts`).
// Copy to `<repoRoot>/cluster.jsonc`, or point `CLUSTER_CONFIG_PATH` at it.
// Relative paths resolve against the repository root, never the launch directory.
{
  // Everything the daemon owns on disk: `state.sqlite` (jobs, tasks, events, workers, locks,
  // messages), `daemon.lock`, `assignments/` (worker stdout/stderr), `mcp/` (per-worker MCP
  // config files) and `ui/` (the built console, served at `/` when present).
  "stateDir": "data/cluster",

  // The one port. `/mcp` for workers (loopback peers only, no token), `/api/cluster/*`,
  // `/api/tickets/*` and `/health` for the bot and the console (Bearer token), `/` for the
  // console build under `<stateDir>/ui`. "0.0.0.0" makes the console reachable over the
  // LAN; "127.0.0.1" keeps everything local. Workers always connect through 127.0.0.1.
  "http": {
    "host": "0.0.0.0",
    "port": 3200
  },

  // Shared secret the bot (`clusterClient.token`) and the console present as
  // `Authorization: Bearer <token>`. Generate one, e.g. `openssl rand -hex 32`.
  "auth": {
    "token": "replace-with-a-long-random-string"
  },

  // The scheduler: worker templates and per-project dispatch rules. Same shape as the
  // `cluster` block the bot's config.jsonc used to carry; `enabled` must be true.
  // `stateDir` / `hub.port` / `hub.bindHost` inside this block are ignored — the daemon's
  // `stateDir` and `http` above are the only source for them.
  "cluster": {
    "enabled": true,
    // Identifier written into tickets/<id>/results/job.json so cross-LAN viewers can tell
    // which machine produced a result. Defaults to the hostname.
    // "clusterId": "mac-mini",
    "schedulingInterval": "30s",
    "maxConcurrentWorkers": 4,
    "hub": {
      // How long a file lock claimed through hub_claim lives without renewal.
      "lockTTL": "10m",
      "eventLogMaxSize": 2000
    },
    // Ask each enabled template's provider whether its credential still works at startup.
    "healthCheck": {
      "probeOnStartup": true,
      "probeTimeout": "10s"
    },
    "workerTemplates": {
      "claude-sonnet": {
        "type": "claude-cli",
        "command": "claude",
        "args": ["--print", "--dangerously-skip-permissions", "--output-format", "text"],
        "maxConcurrent": 2,
        "timeout": "20m",
        "capabilities": ["code"],
        "costTier": "medium",
        "enabled": true,
        "description": "首席程序员。多数功能开发、多文件重构、复杂 API 接入、有难度的 Bug。"
      }
      // Planner-role template for tickets dispatched with `usePlanner: true`:
      // "claude-opus-planner": {
      //   "type": "claude-cli",
      //   "role": "planner",
      //   "command": "claude",
      //   "args": ["--print", "--dangerously-skip-permissions", "--model", "opus"],
      //   "maxConcurrent": 1,
      //   "timeout": "30m",
      //   "capabilities": ["plan"],
      //   "costTier": "high"
      // }
    },
    // "defaultPlannerTemplate": "claude-opus-planner",
    "projects": {
      "qqbot": {
        "maxWorkers": 2,
        "taskSources": [{ "type": "queue" }],
        "workerPreference": "claude-sonnet"
      }
    }
  },

  // Which repositories the cluster may work in. Aliases here are what `cluster.projects`
  // and ticket frontmatter name. Same shape as the bot's `projectRegistry` block.
  "projectRegistry": {
    // Only paths under these directories can be registered or resolved.
    "allowedBasePaths": ["/home/user/projects"],
    "defaultProject": "qqbot",
    "projects": [
      {
        "alias": "qqbot",
        "path": "/home/user/projects/qqbot",
        "type": "bun",
        "description": "QQ bot framework"
      }
    ]
  },

  // Where ticket directories live (`<dir>/<project>/<id>/ticket.md`). Usually a dedicated
  // `cluster-tickets` repository shared across machines. Default: `<repoRoot>/tickets`.
  "tickets": {
    "dir": "/absolute/path/to/cluster-tickets"
  }
}
