{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
    },
    "types": [
      "bun-types"
    ]
  },
  "references": [
    {
      "path": "../avatar"
    }
  ],
  "include": [
    "src/**/*",
    "types/**/*",
    "scripts/builds/**/*",
    "build.config.ts"
  ]
}