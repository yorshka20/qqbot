{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "rootDir": ".",
    // Two candidates for one alias: tsc resolves them against this file's directory and takes
    // `./src/*`, but Bun anchors a baseUrl-less `paths` at the *cwd*, so a root-cwd script
    // (`bun run dev`, `bun test`, smoke-test) only resolves via the second. baseUrl would fix
    // the anchor but is removed in TypeScript 7.
    "paths": {
      "@/*": [
        "./src/*",
        "./packages/bot/src/*"
      ],
    },
    // DOM: the callbacks passed to Puppeteer's page.evaluate run inside Chromium (cards,
    // reports, portraits, the browser fingerprint patch).
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "bun-types"
    ]
  },
  "references": [
    {
      "path": "../agent-cluster"
    },
    {
      "path": "../api-types"
    },
    {
      "path": "../avatar"
    },
    {
      "path": "../llm"
    },
    {
      "path": "../retrieval"
    },
    {
      "path": "../shared"
    }
  ],
  "include": [
    "src/**/*",
    "src/**/*.json",
    "types/**/*",
    "scripts/builds/**/*",
    "build.config.ts"
  ]
}