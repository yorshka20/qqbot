{
  // Bun reads the cwd's tsconfig for compiler options, and every root-cwd entry point (the
  // supervisor's bot process, `bun run dev`, smoke-test) is transpiled against this file. Without the
  // shared options here, decorators emit no metadata and tsyringe fails at resolve time with
  // "TypeInfo not known" — while a run from inside packages/ still works, so it looks like
  // an environment quirk rather than a missing compiler option.
  "extends": "./tsconfig.base.json",
  "files": [],
  "references": [
    { "path": "./packages/agent-cluster" },
    { "path": "./packages/api-types" },
    { "path": "./packages/avatar" },
    { "path": "./packages/bot" },
    { "path": "./packages/llm" },
    { "path": "./packages/retrieval" },
    { "path": "./packages/shared" },
    { "path": "./packages/webui" },
    { "path": "./scripts" }
  ]
}
