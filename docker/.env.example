# Copy to docker/.env and fill in. docker/.env is gitignored.
# Passwords should be alphanumeric: they are interpolated into URLs and CLI args.
#
# Required (docker-compose.yml): LLBot / PMHQ, for QQ.
# Optional (docker-compose.optional.yml): SearXNG, Qdrant, WeChat.
# `docker compose up` does not start the optional groups.

# --- Required: LLBot / PMHQ ---
# From https://auth.luckylillia.com . Required by current LLBot images.
LLBOT_AUTH_TOKEN=
# Empty = sign in from the LLBot WebUI. Digits only when set.
AUTO_LOGIN_QQ=
LLBOT_TAG=latest
PMHQ_TAG=latest
# Optional registry prefix, including the trailing slash.
# Example: docker.1ms.run/
LLBOT_IMAGE_PREFIX=
LLBOT_WEBUI_PORT=3080
# These must be the ports you enable inside the LLBot WebUI, and the ports
# in the bot's protocols config.
LLBOT_MILKY_PORT=3010
LLBOT_OB11_PORT=3001

# The LLBot WebUI password is a file, not an env var:
#   docker/llbot_config/webui_token.txt
# That directory is gitignored.

# --- Optional: SearXNG (profile: search) ---
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://localhost:8080/
# openssl rand -hex 32
SEARXNG_SECRET=

# --- Optional: Qdrant (profile: rag) ---
QDRANT_PORT=6333

# --- Optional: WeChatPadPro (profile: wechat) ---
# Fill these before `--profile wechat`. MySQL refuses an empty root password.
WECHAT_MYSQL_ROOT_PASSWORD=
WECHAT_MYSQL_PASSWORD=
WECHAT_REDIS_PASSWORD=
WECHAT_ADMIN_KEY=
WECHAT_WEB_DOMAIN=localhost:8059
WECHAT_HTTP_PORT=8059
WECHAT_SSE_PORT=8098
WECHAT_WS_PORT=1238
TZ=Asia/Tokyo
